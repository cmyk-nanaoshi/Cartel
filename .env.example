# Copiez ce fichier en .env et remplissez les valeurs. Ne publiez jamais .env.

# --- IA ---
# Sans clé, l'application tourne en mode démonstration (identification simulée).
ANTHROPIC_API_KEY=
# AI_PROVIDER=anthropic          # anthropic | openai | demo (déduit automatiquement)
# ANTHROPIC_VISION_MODEL=claude-sonnet-5-5
# ANTHROPIC_TEXT_MODEL=claude-sonnet-5-5
# ANTHROPIC_CHAT_MODEL=claude-haiku-5-5
# ANTHROPIC_LABEL_MODEL=claude-haiku-5-5

# Fournisseur alternatif compatible OpenAI (non testé)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Sources documentaires ---
# Clé gratuite api.data.gov pour activer le Smithsonian
SMITHSONIAN_API_KEY=
# Adresse de contact transmise dans le User-Agent (demandé par Wikidata et l'AIC)
CONTACT_EMAIL=
# SOURCES_DISABLED=rijksmuseum,met
# JOCONDE_API_BASE=https://data.culture.gouv.fr/api/explore/v2.1/catalog/datasets/base-joconde-extrait/records

# --- Protection et coûts ---
# Code demandé par l'application avant tout appel (fortement conseillé si l'URL est publique)
APP_ACCESS_CODE=
DAILY_BUDGET_USD=2
RATE_LIMIT_PER_MINUTE=12

# --- Serveur ---
PORT=8787
CACHE_DIR=.cache
